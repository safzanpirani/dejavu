{
  "name": "deja",
  "version": "0.2.0",
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  },
  "bin": {
    "deja": "./src/cli.ts"
  },
  "description": "Agent-first local search for coding-agent transcripts and project memory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safzanpirani/dejavu.git"
  },
  "homepage": "https://github.com/safzanpirani/dejavu#readme",
  "bugs": "https://github.com/safzanpirani/dejavu/issues",
  "keywords": [
    "agent-memory",
    "claude-code",
    "codex",
    "opencode",
    "pi"
  ],
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "deja": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "build:local": "bun build --compile src/cli.ts --outfile dist/deja && codesign --force --sign - dist/deja",
    "build:linux": "bun build --compile --target=bun-linux-x64 src/cli.ts --outfile dist/deja-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 src/cli.ts --outfile dist/deja-linux-arm64"
  },
  "type": "module"
}
