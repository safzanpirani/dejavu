{
  "name": "@safzanpirani/dejavu",
  "version": "0.5.0",
  "description": "Agent-first local search for coding-agent transcripts and project memory",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dejavu": "bin/dejavu.cjs",
    "deja": "bin/dejavu.cjs"
  },
  "files": [
    "bin/",
    "scripts/npm-binary.cjs",
    "scripts/npm-postinstall.cjs",
    "skills/",
    "checksums.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safzanpirani/dejavu.git"
  },
  "homepage": "https://github.com/safzanpirani/dejavu#readme",
  "bugs": "https://github.com/safzanpirani/dejavu/issues",
  "keywords": [
    "agent-memory",
    "claude-code",
    "codex",
    "opencode",
    "pi"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test",
    "postinstall": "node scripts/npm-postinstall.cjs"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  }
}
